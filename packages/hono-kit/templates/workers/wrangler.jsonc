{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__APP_NAME__",
  "main": "src/main.ts",
  "compatibility_date": "2026-09-01",
  // Writes src/routes.gen.ts before wrangler dev and wrangler deploy, and again while dev runs when src/routes changes
  "build": { "command": "pnpm hnk prepare", "watch_dir": "src/routes" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__APP_NAME__",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
}
