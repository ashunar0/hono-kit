{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "vitest"],
  "jsPlugins": ["hono-kit/lint"],
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "vitest/no-restricted-vi-methods": [
      "error",
      {
        "mock": "Do not replace modules. Pass a stand-in through deps (buildApp(makeDeps), appAs(user)) or use the real local D1",
        "doMock": "Do not replace modules. Pass a stand-in through deps (buildApp(makeDeps), appAs(user)) or use the real local D1"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "hnk/layer-imports": "error",
        "hnk/no-foreign-table-reads": "error",
        "hnk/no-clock-outside-inbound": "error",
        "hnk/route-lists-are-paged": "error",
        "hnk/route-replies-through-reply": "error",
        "hnk/route-declares-auth": "error",
        "hnk/no-module-scope-state": "error",
        "hnk/no-id-cast": "error"
      }
    }
  ]
}
