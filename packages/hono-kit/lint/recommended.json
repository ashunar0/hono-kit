{
  "jsPlugins": ["./index.mjs"],
  "plugins": ["import", "typescript"],
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "hnk/no-clock-outside-app-entry": "error",
        "hnk/route-exports-endpoints": "error",
        "hnk/route-replies-through-reply": "error",
        "hnk/route-responds-200": "error",
        "hnk/no-new-hono": "error",
        "hnk/no-module-scope-state": "error",
        "hnk/no-id-cast": "error"
      }
    }
  ]
}
